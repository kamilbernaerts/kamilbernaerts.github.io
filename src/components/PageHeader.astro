---
// The same header on every page: title, one or two sentences, optional buttons.
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---
<section class="page-header">
  <div class="container">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {Astro.slots.has('default') && <div class="page-header__actions"><slot /></div>}
  </div>
</section>
