---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
}
const {
  title,
  description = "Political scientist studying polarisation, democracy, and democratic resilience.",
  lang = "en",
  image = "/images/kamil-bernaerts.jpg",
} = Astro.props;
const currentPath = Astro.url.pathname;
const buildDate = new Date();
const isoDate = buildDate.toISOString().slice(0, 10);
const longDate = buildDate.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const ogImage = `https://kamilbernaerts.com${image}`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Dr. Kamil Bernaerts</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} — Kamil Bernaerts`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={`https://kamilbernaerts.com${currentPath}`} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" />
  <script data-goatcounter="https://kamilbernaerts.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head>
<body>
  <header class={currentPath === '/' ? 'masthead' : 'masthead masthead--compact'}>
    <div class="container">
      <a href="/" class="masthead__name">Polarised Times</a>
      <div class="dateline">
        <span>Researcher, speaker, lecturer</span>
        <span class="dateline__name">Dr. Kamil Bernaerts</span>
        <time id="today" datetime={isoDate}>{longDate}</time>
      </div>
      <nav aria-label="Main">
        <ul class="site-nav">
          <li><a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a></li>
          <li><a href="/research/" class={currentPath.startsWith('/research') ? 'active' : ''}>Research</a></li>
          <li><a href="/phd/" class={currentPath.startsWith('/phd') ? 'active' : ''}>PhD</a></li>
          <li><a href="/teaching/" class={currentPath.startsWith('/teaching') ? 'active' : ''}>Teaching</a></li>
          <li><a href="/outreach/" class={currentPath.startsWith('/outreach') ? 'active' : ''}>Outreach</a></li>
          <li><a href="/writing/" class={currentPath.startsWith('/writing') ? 'active' : ''}>Writing</a></li>
          <li><a href="/cv/" class={currentPath.startsWith('/cv') ? 'active' : ''}>CV</a></li>
          <li><a href="/contact/" class={currentPath.startsWith('/contact') ? 'active' : ''}>Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-links">
        <a href="/contact/">Contact</a>
        <a href="https://scholar.google.com/citations?user=7Pmo70UAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a>
        <a href="https://researchportal.vub.be/en/persons/kamil-bernaerts" target="_blank" rel="noopener">VUB Research Portal</a>
        <a href="https://orcid.org/0000-0002-3380-6639" target="_blank" rel="noopener">ORCID</a>
        <a href="https://kamilbernaerts.bsky.social" target="_blank" rel="noopener">Bluesky</a>
        <a href="https://be.linkedin.com/in/kamil-bernaerts-431753201" target="_blank" rel="noopener">LinkedIn</a>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Kamil Bernaerts. All rights reserved.</p>
    </div>
  </footer>

  <script>
    // Today's date in the masthead, refreshed on every visit.
    const today = document.getElementById('today');
    if (today) {
      const now = new Date();
      today.dateTime = now.toISOString().slice(0, 10);
      today.textContent = now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    }
  </script>
</body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
