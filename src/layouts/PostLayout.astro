---
// src/layouts/PostLayout.astro
const { title, description, date, lang, venue, venueUrl, authors, tags, image } = Astro.props.frontmatter ?? Astro.props;

import BaseLayout from './BaseLayout.astro';
---

<BaseLayout title={title} description={description} image={image} lang={lang ? lang.toLowerCase() : undefined}>

  <section class="page-header post-header">
    <div class="container--narrow">
      <p class="post-header__back"><a href="/writing/">← Writing</a></p>

      <div class="post-header__meta">
        {lang && <span class="post-card__lang">{lang}</span>}
        <span>{date}</span>
        {venue && venueUrl && (
          <>
            <span>·</span>
            <a href={venueUrl} target="_blank" rel="noopener">{venue}</a>
          </>
        )}
        {venue && !venueUrl && (
          <>
            <span>·</span>
            <span>{venue}</span>
          </>
        )}
      </div>

      <h1>{title}</h1>

      {authors && <p class="lead">{authors}</p>}
    </div>
  </section>

  {venue && (
    <div class="container--narrow">
      <p class="post-notice">
        Dit artikel verscheen oorspronkelijk op
        {venueUrl
          ? <a href={venueUrl} target="_blank" rel="noopener">{venue}</a>
          : <strong>{venue}</strong>
        }
        {' '}({date}).
      </p>
    </div>
  )}

  <div class="container--narrow post-body">
    <slot />
  </div>

  <div class="container--narrow">
    <div class="post-footer">
      {tags && tags.length > 0 && (
        <p class="post-tags">{tags.join(' · ')}</p>
      )}
      <a href="/writing/" class="more-link" style="margin-top: 0;">← Back to Writing</a>
    </div>
  </div>

</BaseLayout>
