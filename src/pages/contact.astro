---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkCard from '../components/LinkCard.astro';
---
<BaseLayout title="Contact" description="Get in touch with Kamil Bernaerts.">

  <PageHeader
    title="Contact"
    lead="For research collaborations, lectures, media requests or questions about my work, email is the fastest way to reach me."
  />

  <!-- EMAIL + PHOTO -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <div class="section__head">
            <p class="eyebrow">Email</p>
            <h2>Write to me</h2>
          </div>
          <div class="stack">
            <LinkCard href="mailto:kamil.bernaerts@vub.be" title="VUB — research and general questions" sub="kamil.bernaerts@vub.be" />
            <LinkCard href="mailto:kamil.bernaerts@uhasselt.be" title="UHasselt — teaching" sub="kamil.bernaerts@uhasselt.be" />
            <LinkCard href="mailto:kamil.bernaerts@hannah-arendt.institute" title="Hannah Arendt Instituut — outreach" sub="kamil.bernaerts@hannah-arendt.institute" />
          </div>
        </div>
        <img src="/images/profiel-vub.jpeg" alt="Dr. Kamil Bernaerts" class="photo" style="aspect-ratio: 1; border-radius: 50%; max-width: 280px; margin: 0 auto;" />
      </div>
    </div>
  </section>

  <!-- PROFILES -->
  <section class="section section--blue-tint">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Online</p>
        <h2>Profiles</h2>
      </div>
      <div class="grid-3">
        <LinkCard href="https://scholar.google.com/citations?user=7Pmo70UAAAAJ&hl=en" title="Google Scholar" sub="Publications and citations" />
        <LinkCard href="https://orcid.org/0000-0002-3380-6639" title="ORCID" sub="0000-0002-3380-6639" />
        <LinkCard href="https://researchportal.vub.be/en/persons/kamil-bernaerts" title="VUB Research Portal" sub="Institutional profile" />
        <LinkCard href="https://be.linkedin.com/in/kamil-bernaerts-431753201" title="LinkedIn" sub="Kamil Bernaerts" />
        <LinkCard href="https://kamilbernaerts.bsky.social" title="Bluesky" sub="@kamilbernaerts.bsky.social" />
      </div>
    </div>
  </section>

  <!-- WHY ARE YOU WRITING -->
  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div class="card">
          <h3>For public engagement</h3>
          <p>I am available for guest lectures, panel discussions, workshops, school visits, and media commentary on topics related to polarisation, democratic resilience, and the state of democracy.</p>
          <a href="/outreach/" class="more-link">See what I offer →</a>
        </div>
        <div class="card">
          <h3>For academic inquiries</h3>
          <p>If you're interested in collaborating on research projects and papers or have questions about my work, please reach out via email.</p>
          <a href="/research/" class="more-link">See my research →</a>
        </div>
      </div>
      <p class="small muted" style="margin-top: 2rem;">Office: Vrije Universiteit Brussel, Pleinlaan 2, 1050 Brussels, Belgium</p>
    </div>
  </section>

</BaseLayout>
