---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkCard from '../components/LinkCard.astro';
---

<BaseLayout title="CV" description="Academic curriculum vitae of Dr. Kamil Bernaerts.">

  <PageHeader
    title="Curriculum vitae"
    lead="Postdoctoral researcher at VUB, guest professor at UHasselt and senior academic fellow at the Hannah Arendt Institute."
  >
    <a href="/Academic_cv_Kamil_Bernaerts.pdf" target="_blank" rel="noopener" class="btn">Download full CV (PDF)</a>
  </PageHeader>

  <!-- AT A GLANCE -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>At a glance</h2>
      </div>
      <div class="grid-3">
        <div class="fact">
          <p class="fact__label">Languages</p>
          <p class="fact__value">Dutch (native)<br>English (proficient)</p>
        </div>
        <div class="fact">
          <p class="fact__label">Skills</p>
          <p class="fact__value">R (5 years)<br>SPSS and Stata<br>Survey experiments: design &amp; fielding</p>
        </div>
        <div class="fact">
          <p class="fact__label">Peer review</p>
          <p class="fact__value">Acta Politica · European Journal of Political Research · European Political Science Review · Frontiers in Political Science · Nature Human Behaviour · Perspectives on Politics · Political Behavior · Social Inclusion · Social Science Quarterly · Oxford Handbook on Icelandic Politics</p>
        </div>
      </div>
    </div>
  </section>

  <!-- POSITIONS -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Current positions</h2>
      </div>
      <div class="entry-list">
        <div class="entry">
          <div>
            <h3 class="entry__title">Post-doctoral researcher</h3>
            <p class="entry__sub">Vrije Universiteit Brussel · Evaluating Democratic Governance in Europe (EDGE)</p>
          </div>
          <div class="entry__meta"><p>2025–2026</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Guest professor (10%)</h3>
            <p class="entry__sub">Universiteit Hasselt · Introduction to Political Science and Governance</p>
          </div>
          <div class="entry__meta"><p>2025–2027</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Senior academic fellow</h3>
            <p class="entry__sub">Hannah Arendt Institute, Mechelen</p>
          </div>
          <div class="entry__meta"><p>2022–present</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Education</h2>
      </div>
      <div class="entry-list">
        <div class="entry">
          <div>
            <h3 class="entry__title">PhD in Political Science</h3>
            <p class="entry__sub">Vrije Universiteit Brussel &amp; University of Warwick · EUTOPIA Co-tutelle</p>
          </div>
          <div class="entry__meta"><p>2021–2025</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">MSc Political Sciences: European and International Governance</h3>
            <p class="entry__sub">Vrije Universiteit Brussel · Summa Cum Laude</p>
          </div>
          <div class="entry__meta"><p>2020–2021</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">BSc Social Sciences (minor Political Science)</h3>
            <p class="entry__sub">Vrije Universiteit Brussel &amp; Universiteit Gent · Magna Cum Laude</p>
          </div>
          <div class="entry__meta"><p>2017–2020</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRIZES -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Prizes &amp; awards</h2>
      </div>
      <div class="entry-list">
        <div class="entry">
          <div>
            <h3 class="entry__title">Frank Cass Prize for Best Article of 2023</h3>
            <p class="entry__sub"><em>Democratization</em> (journal)</p>
          </div>
          <div class="entry__meta"><p>2024</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">EUTOPIA Co-tutelle PhD Scholarship</h3>
            <p class="entry__sub">EUTOPIA university alliance</p>
          </div>
          <div class="entry__meta"><p>2021</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Excellence Award — top student in master's programme</h3>
            <p class="entry__sub">Faculty of Economy and Social Sciences, VUB</p>
          </div>
          <div class="entry__meta"><p>2021</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROFESSIONAL SERVICE -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Professional service</h2>
      </div>
      <div class="entry-list">
        <div class="entry">
          <div>
            <h3 class="entry__title">Academic workshop co-organiser</h3>
            <p class="entry__sub">Planned international workshop "The end of affective polarization?" · Brussels Institute for Advanced Studies (BrIAS)</p>
          </div>
          <div class="entry__meta"><p>2026–2027</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Jury member, Daniël Heinsius Prize for best master thesis</h3>
            <p class="entry__sub">Organised by the VPW and NKWP</p>
          </div>
          <div class="entry__meta"><p>2026</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Academic workshop co-organiser</h3>
            <p class="entry__sub">International workshop "Polarising Performances or Re-engaging the Audience?" · University of Warwick</p>
          </div>
          <div class="entry__meta"><p>2025</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Panel chair</h3>
            <p class="entry__sub">World Values Conference on (De)polarisation in values, attitudes &amp; beliefs: comparative perspectives · King's College London</p>
          </div>
          <div class="entry__meta"><p>2024</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Panel chair</h3>
            <p class="entry__sub">ECPR General Conference · University of Innsbruck</p>
          </div>
          <div class="entry__meta"><p>2022</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- READ FURTHER -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Publications and writing</h2>
        <p>The full CV lists every publication, conference presentation, teaching role and professional service. The highlights are on these pages.</p>
      </div>
      <div class="grid-3">
        <LinkCard href="/research/#publications" title="Publications" sub="Articles, book and dataset, with abstracts" />
        <LinkCard href="/writing/" title="Essays & op-eds" sub="Writing for a wide audience" />
        <LinkCard href="/Academic_cv_Kamil_Bernaerts.pdf" title="Full CV (PDF)" sub="Complete overview" />
      </div>
    </div>
  </section>

</BaseLayout>
