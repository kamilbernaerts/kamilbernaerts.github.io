---
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import { featured } from '../data/publications.js';
---

<BaseLayout title="Home" description="Political scientist at Vrije Universiteit Brussel, studying the fascinating relationship between conflict and democracy.">

  <!-- FRONT PAGE: lead story + colophon -->
  <section>
    <div class="container">
      <div class="front">
        <article class="front__lead">
          <h1>Polarisation versus democracy?</h1>
          <p class="lead">On the fine line between the conflict democracies need and the conflict that harms them.</p>
          <p class="byline">By Kamil Bernaerts, postdoctoral researcher at Vrije Universiteit Brussel</p>
          <div class="front__story">
            <div class="prose">
              <p>I am a doctor in Political Science, studying social conflict and polarisation within democratic societies. I specifically want to identify the fine line between harmful conflict and democracy.</p>
              <p>To do so, I devoted my <a href="/phd/">PhD dissertation</a> to the question whether polarisation undermines democracy. It was published as a book by VUBPRESS in 2025. I am continuing my <a href="/cv/">academic career</a> as a postdoctoral researcher at VUB, working on the broader question of conflict and democracy.</p>
              <p>I also teach an introductory course on political science at UHasselt, and regularly give <a href="/outreach/">public lectures</a> on my research.</p>
            </div>
            <figure class="figure">
              <img src="/images/kamil-bernaerts.jpg" alt="Dr. Kamil Bernaerts" />
              <figcaption>Kamil Bernaerts. Photo: Greetje Van Buggenhout</figcaption>
            </figure>
          </div>
        </article>

        <aside class="colophon">
          <h2>Colophon</h2>
          <div class="fact">
            <p class="fact__label">Positions</p>
            <p class="fact__value">
              Postdoctoral researcher, Vrije Universiteit Brussel<br>
              Guest professor, Universiteit Hasselt<br>
              Senior academic fellow, Hannah Arendt Instituut
            </p>
          </div>
          <div class="fact">
            <p class="fact__label">Research interests</p>
            <p class="fact__value">
              Affective polarisation<br>
              Democratic institutions<br>
              Anti-democratic behavior<br>
              Political conflict
            </p>
          </div>
          <div class="fact">
            <p class="fact__label">PhD</p>
            <p class="fact__value">Vrije Universiteit Brussel &amp; University of Warwick, 2025. Published as a book by VUBPRESS.</p>
            <a href="/phd/" class="more-link" style="margin-top: 0.4rem;">About my PhD →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- THE THREE ROLES -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>What I do</h2>
      </div>
      <div class="grid-3">
        <div class="fact">
          <h3>Researcher</h3>
          <p>I study how different kinds of polarisation relate to democracy, and how democratic institutions shape polarisation and its consequences.</p>
          <a href="/research/" class="more-link" style="margin-top: 0.4rem;">Research and publications →</a>
        </div>
        <div class="fact">
          <h3>Speaker</h3>
          <p>I give lectures, workshops and panel contributions on polarisation and democracy, in Dutch and English, for audiences from schools to local governments.</p>
          <a href="/outreach/" class="more-link" style="margin-top: 0.4rem;">Lectures and media →</a>
        </div>
        <div class="fact">
          <h3>Lecturer</h3>
          <p>I teach Introduction to Political Science and Governance at UHasselt and supervise bachelor theses on polarisation and democracy at VUB.</p>
          <a href="/teaching/" class="more-link" style="margin-top: 0.4rem;">Teaching →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- RECENT PUBLICATIONS -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Recent publications</h2>
      </div>
      <div class="entry-list entry-list--cols">
        {featured.map((pub) => <Publication pub={pub} />)}
      </div>
      <a href="/research/" class="more-link">All publications →</a>
    </div>
  </section>

  <!-- AWARDS -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Awards</h2>
      </div>
      <div class="grid-3">
        <div class="fact">
          <p class="fact__meta">2024 · Democratization</p>
          <h3>Frank Cass Prize</h3>
          <p>Best article of 2023, for our study of polarisation in consensus and majoritarian democracies. <a href="https://www.tandfonline.com/journals/fdem20/collections/best-paper-frank-cass-prize" target="_blank" rel="noopener">About the prize ↗</a></p>
        </div>
        <div class="fact">
          <p class="fact__meta">2021 · EUTOPIA university alliance</p>
          <h3>EUTOPIA Co-tutelle PhD Scholarship</h3>
          <p>Funding for a joint PhD at Vrije Universiteit Brussel and the University of Warwick.</p>
        </div>
        <div class="fact">
          <p class="fact__meta">2021 · Vrije Universiteit Brussel</p>
          <h3>Excellence Award</h3>
          <p>Top student in the master's programme, Faculty of Economy and Social Sciences. <a href="/cv/">Full CV →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUTREACH -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Public lectures and outreach</h2>
      </div>
      <div class="split split--even">
        <div class="prose">
          <p>As a publicly funded researcher, I give public lectures when I am invited to events on polarisation, democracy and critical thinking. This includes the <a href="https://www.vub.be/nl/nieuws/vub-pact-school-tour-caroline-pauwels-atheneum-polarisatie" target="_blank" rel="noopener">PACT school tour</a>, a VUB initiative through which I give guest lectures for secondary school students.</p>
          <p>As a senior academic fellow at the <a href="https://hannah-arendt.institute/samenwerken/onderzoeker/" target="_blank" rel="noopener">Hannah Arendt Institute</a>, I help organise academic and public events and bring expertise and insights to the Institute.</p>
          <a href="/outreach/" class="more-link">Lectures, workshops and media →</a>
        </div>
        <figure class="figure">
          <img src="/images/kamil-presenting.jpg" alt="Kamil Bernaerts giving a public lecture" />
          <figcaption>Photo: Greetje Van Buggenhout</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Contact</h2>
      </div>
      <p>
        <a href="mailto:kamil.bernaerts@vub.be">kamil.bernaerts@vub.be</a> ·
        <a href="https://scholar.google.com/citations?user=7Pmo70UAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a> ·
        <a href="https://orcid.org/0000-0002-3380-6639" target="_blank" rel="noopener">ORCID</a> ·
        <a href="https://be.linkedin.com/in/kamil-bernaerts-431753201" target="_blank" rel="noopener">LinkedIn</a> ·
        <a href="https://kamilbernaerts.bsky.social" target="_blank" rel="noopener">Bluesky</a>
      </p>
      <a href="/contact/" class="more-link">All contact details →</a>
    </div>
  </section>

</BaseLayout>
