---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import Publication from '../components/Publication.astro';
import { featured } from '../data/publications.js';
---

<BaseLayout title="Home" description="Political scientist at Vrije Universiteit Brussel, studying the fascinating relationship between conflict and democracy.">

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-layout">
        <div>
          <h1>Polarisation versus democracy?</h1>
          <p class="lead">
            I am a political scientist at Vrije Universiteit Brussel. I study social conflict and polarisation within democratic societies, and try to identify the fine line between harmful conflict and democracy. I also give public lectures on that research.
          </p>
          <div class="btn-row">
            <a href="/research/" class="btn">Research and publications</a>
            <a href="/outreach/" class="btn btn--outline">Public lectures</a>
          </div>
        </div>
        <div>
          <img src="/images/kamil-bernaerts.jpg" alt="Dr. Kamil Bernaerts" class="hero-photo" />
          <p class="caption">&copy; Greetje Van Buggenhout</p>
        </div>
      </div>
    </div>
  </section>

  <!-- POSITIONS / INTERESTS / AWARDS -->
  <section class="section">
    <div class="container">
      <div class="grid-3">
        <div class="fact">
          <p class="fact__label">Positions</p>
          <p class="fact__value">
            Postdoctoral researcher, Vrije Universiteit Brussel<br>
            Guest professor, Universiteit Hasselt<br>
            Senior academic fellow, Hannah Arendt Instituut
          </p>
        </div>
        <div class="fact">
          <p class="fact__label">Research interests</p>
          <p class="fact__value">
            Affective polarisation<br>
            Democratic institutions<br>
            Anti-democratic behavior<br>
            Political conflict
          </p>
        </div>
        <div class="fact">
          <p class="fact__label">PhD</p>
          <p class="fact__value">
            Vrije Universiteit Brussel &amp; University of Warwick, 2025<br>
            Published as a book by VUBPRESS<br>
            <a href="/phd/">About my PhD →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RECENT PUBLICATIONS -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__head">
        <h2>Recent publications</h2>
      </div>
      <div class="entry-list">
        {featured.map((pub) => <Publication pub={pub} />)}
      </div>
      <a href="/research/" class="more-link">All publications →</a>
    </div>
  </section>

  <!-- AWARDS -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Awards</h2>
      </div>
      <div class="grid-3">
        <div class="fact">
          <p class="fact__label">2024 · <em>Democratization</em></p>
          <h3>Frank Cass Prize</h3>
          <p>Best article of 2023, for our study of polarisation in consensus and majoritarian democracies. <a href="https://www.tandfonline.com/journals/fdem20/collections/best-paper-frank-cass-prize" target="_blank" rel="noopener">About the prize ↗</a></p>
        </div>
        <div class="fact">
          <p class="fact__label">2021 · EUTOPIA university alliance</p>
          <h3>EUTOPIA Co-tutelle PhD Scholarship</h3>
          <p>Funding for a joint PhD at Vrije Universiteit Brussel and the University of Warwick.</p>
        </div>
        <div class="fact">
          <p class="fact__label">2021 · Vrije Universiteit Brussel</p>
          <h3>Excellence Award</h3>
          <p>Top student in the master's programme, Faculty of Economy and Social Sciences. <a href="/cv/">Full CV →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUTREACH -->
  <section class="section section--alt">
    <div class="container">
      <div class="split split--even">
        <div>
          <h2>Public lectures and outreach</h2>
          <p class="prose">As a publicly funded researcher, I give public lectures when I am invited to events on polarisation, democracy and critical thinking. This includes the <a href="https://www.vub.be/nl/nieuws/vub-pact-school-tour-caroline-pauwels-atheneum-polarisatie" target="_blank" rel="noopener">PACT school tour</a>, a VUB initiative through which I give guest lectures for secondary school students. I am also a senior academic fellow at the <a href="https://hannah-arendt.institute/samenwerken/onderzoeker/" target="_blank" rel="noopener">Hannah Arendt Institute</a>.</p>
          <a href="/outreach/" class="more-link">Lectures, workshops and media →</a>
        </div>
        <figure class="figure">
          <img src="/images/kamil-presenting.jpg" alt="Kamil Bernaerts giving a public lecture" />
          <figcaption>&copy; Greetje Van Buggenhout</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- WHERE TO GO -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Where to find what</h2>
      </div>
      <div class="grid-4">
        <LinkCard href="/research/" title="For researchers" sub="Publications, data and working papers" />
        <LinkCard href="/teaching/" title="For students" sub="Courses and thesis supervision" />
        <LinkCard href="/outreach/" title="For media and organisers" sub="Lectures, workshops and press coverage" />
        <LinkCard href="/writing/" title="For readers" sub="Essays and op-eds, in Dutch and English" />
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__head">
        <h2>Contact</h2>
      </div>
      <div class="grid-3">
        <LinkCard href="mailto:kamil.bernaerts@vub.be" title="Email" sub="kamil.bernaerts@vub.be" />
        <LinkCard href="https://be.linkedin.com/in/kamil-bernaerts-431753201" title="LinkedIn" sub="Kamil Bernaerts" />
        <LinkCard href="https://kamilbernaerts.bsky.social" title="Bluesky" sub="@kamilbernaerts.bsky.social" />
        <LinkCard href="https://scholar.google.com/citations?user=7Pmo70UAAAAJ&hl=en" title="Google Scholar" sub="Publications and citations" />
        <LinkCard href="https://orcid.org/0000-0002-3380-6639" title="ORCID" sub="0000-0002-3380-6639" />
        <LinkCard href="/contact/" title="All contact details" sub="Other email addresses and profiles" />
      </div>
    </div>
  </section>

</BaseLayout>
