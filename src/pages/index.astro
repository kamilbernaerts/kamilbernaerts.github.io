---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import Publication from '../components/Publication.astro';
import { featured } from '../data/publications.js';
---

<BaseLayout title="Home" description="Political scientist at Vrije Universiteit Brussel, studying the fascinating relationship between conflict and democracy.">

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-layout">
        <div>
          <p class="eyebrow">Dr. Kamil Bernaerts · Political scientist</p>
          <h1>Polarisation versus democracy?</h1>
          <p class="lead">
            I study the fine line between the conflict democracies need and the conflict that destroys them.
            <strong>Not all polarisation is a threat</strong>, and my research shows which kinds are.
          </p>
          <div class="btn-row">
            <a href="/research/" class="btn">Explore my research →</a>
            <a href="/outreach/#invite" class="btn btn--ghost">Invite me to speak</a>
          </div>
        </div>
        <div>
          <img src="/images/kamil-bernaerts.jpg" alt="Dr. Kamil Bernaerts" class="hero-photo" />
          <p class="caption">&copy; Greetje Van Buggenhout</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  <section>
    <div class="container">
      <div class="highlights">
        <div class="highlight">
          <p class="highlight__title">Frank Cass Prize</p>
          <p class="highlight__text">Best 2023 article in <em>Democratization</em></p>
        </div>
        <div class="highlight">
          <p class="highlight__title">Book with VUBPRESS</p>
          <p class="highlight__text">PhD from VUB &amp; University of Warwick, published in 2025</p>
        </div>
        <div class="highlight">
          <p class="highlight__title">Three roles</p>
          <p class="highlight__text">Postdoc at VUB, guest professor at UHasselt, senior fellow at the Hannah Arendt Institute</p>
        </div>
        <div class="highlight">
          <p class="highlight__title">Public speaker</p>
          <p class="highlight__text">Lectures and workshops in Dutch and English</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AUDIENCES -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Find your way</p>
        <h2>What brings you here?</h2>
      </div>
      <div class="grid-4">
        <a href="/research/" class="audience-card">
          <span class="audience-card__for">For researchers</span>
          <span class="audience-card__title">Publications &amp; data</span>
          <span class="audience-card__text">Articles, open data and working papers on affective polarisation and democratic institutions.</span>
          <span class="audience-card__cta">Go to research →</span>
        </a>
        <a href="/outreach/" class="audience-card audience-card--ochre">
          <span class="audience-card__for">For media &amp; organisers</span>
          <span class="audience-card__title">Talks &amp; commentary</span>
          <span class="audience-card__text">Keynotes, workshops, panels and expert commentary on polarisation and democracy.</span>
          <span class="audience-card__cta">Go to outreach →</span>
        </a>
        <a href="/teaching/" class="audience-card audience-card--deep">
          <span class="audience-card__for">For students</span>
          <span class="audience-card__title">Courses &amp; theses</span>
          <span class="audience-card__text">The courses I teach at UHasselt and VUB, and the thesis topics I supervise.</span>
          <span class="audience-card__cta">Go to teaching →</span>
        </a>
        <a href="/writing/" class="audience-card audience-card--tint">
          <span class="audience-card__for">For curious readers</span>
          <span class="audience-card__title">Essays &amp; op-eds</span>
          <span class="audience-card__text">Accessible pieces on the state of democracy, in Dutch and English.</span>
          <span class="audience-card__cta">Go to writing →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ACHIEVEMENTS -->
  <section class="section section--blue-tint">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Achievements</p>
        <h2>Awards &amp; recognition</h2>
      </div>
      <div class="grid-3">
        <div class="card card--award">
          <p class="card__meta">2024 · <em>Democratization</em></p>
          <h3>Frank Cass Prize</h3>
          <p>Best article of 2023, for our study of whether consensus democracies fare better against polarisation. <a href="https://www.tandfonline.com/journals/fdem20/collections/best-paper-frank-cass-prize" target="_blank" rel="noopener">About the prize ↗</a></p>
        </div>
        <div class="card card--award">
          <p class="card__meta">2021 · EUTOPIA university alliance</p>
          <h3>EUTOPIA Co-tutelle PhD Scholarship</h3>
          <p>Funded my joint PhD at Vrije Universiteit Brussel and the University of Warwick. <a href="/phd/">About my PhD →</a></p>
        </div>
        <div class="card card--award">
          <p class="card__meta">2021 · VUB</p>
          <h3>Excellence Award</h3>
          <p>Top student in the master's programme, Faculty of Economy and Social Sciences. <a href="/cv/">Full CV →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED PUBLICATIONS -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Research</p>
        <h2>Featured publications</h2>
        <p>Open each abstract to read what the study found, without leaving this page.</p>
      </div>
      <div class="entry-list">
        {featured.map((pub) => <Publication pub={pub} />)}
      </div>
      <a href="/research/" class="more-link">All publications →</a>
    </div>
  </section>

  <!-- OUTREACH -->
  <section class="section section--alt">
    <div class="container">
      <div class="split split--even">
        <div>
          <p class="eyebrow">Societal outreach</p>
          <h2>Research that leaves the university</h2>
          <p class="prose">As a publicly funded researcher, I give public lectures on polarisation and critical thinking, including the <a href="https://www.vub.be/nl/nieuws/vub-pact-school-tour-caroline-pauwels-atheneum-polarisatie" target="_blank" rel="noopener">PACT school tour</a> for secondary schools. As a senior academic fellow at the <a href="https://hannah-arendt.institute/samenwerken/onderzoeker/" target="_blank" rel="noopener">Hannah Arendt Institute</a>, I help bring research to policymakers and civil society.</p>
          <div class="btn-row">
            <a href="/outreach/#invite" class="btn btn--blue">Invite me to speak →</a>
          </div>
        </div>
        <figure class="figure">
          <img src="/images/kamil-presenting.jpg" alt="Kamil Bernaerts giving a public lecture" />
          <figcaption>&copy; Greetje Van Buggenhout</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Contact</p>
        <h2>Get in touch</h2>
      </div>
      <div class="grid-3">
        <LinkCard href="mailto:kamil.bernaerts@vub.be" title="Email (VUB)" sub="kamil.bernaerts@vub.be" />
        <LinkCard href="https://be.linkedin.com/in/kamil-bernaerts-431753201" title="LinkedIn" sub="Kamil Bernaerts" />
        <LinkCard href="https://kamilbernaerts.bsky.social" title="Bluesky" sub="@kamilbernaerts.bsky.social" />
        <LinkCard href="https://scholar.google.com/citations?user=7Pmo70UAAAAJ&hl=en" title="Google Scholar" sub="Publications and citations" />
        <LinkCard href="https://orcid.org/0000-0002-3380-6639" title="ORCID" sub="0000-0002-3380-6639" />
        <LinkCard href="/contact/" title="All contact details" sub="Other email addresses and profiles" />
      </div>
    </div>
  </section>

</BaseLayout>
