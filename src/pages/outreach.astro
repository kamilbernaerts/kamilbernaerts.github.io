---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkCard from '../components/LinkCard.astro';
---

<BaseLayout title="Outreach" description="Public engagement: the Hannah Arendt Institute, public lectures, the PACT School Tour, and media appearances.">

  <PageHeader
    title="Outreach"
    lead="Interested in inviting me? I am available for lectures, workshops, and panel contributions on polarisation and democracy, in Dutch and English."
  >
    <a href="/contact/" class="btn">Get in touch →</a>
    <a href="#invite" class="btn btn--ghost">What I offer</a>
  </PageHeader>

  <!-- OVERVIEW: what + which topics -->
  <section class="section" id="invite">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Overview</p>
        <h2>What you can invite me for</h2>
        <p>As a publicly funded researcher, I believe research should serve the broader society. Pick a format to read more further down this page.</p>
      </div>
      <div class="grid-4">
        <LinkCard href="#lectures" title="Lectures & workshops" sub="Keynotes, workshops, panels, school visits" />
        <LinkCard href="#media" title="Media commentary" sub="Expert input for press, radio and TV" />
        <LinkCard href="#public-writing" title="Essays & op-eds" sub="Accessible writing for your publication" />
        <LinkCard href="#hai" title="Hannah Arendt Institute" sub="Events with civil society and policymakers" />
      </div>

      <h3 style="margin-top: 2.5rem; margin-bottom: 1rem;">Topics I speak and write on</h3>
      <div class="grid-3">
        <div class="card">
          <h4>Polarisation &amp; democracy</h4>
          <p>Does polarisation really undermine democracy? What does the research say, and what can we do about it?</p>
        </div>
        <div class="card">
          <h4>Affective polarisation</h4>
          <p>Why do we dislike people who vote differently? The psychology and politics of us-versus-them thinking.</p>
        </div>
        <div class="card">
          <h4>Institutional design &amp; conflict</h4>
          <p>How do political institutions shape the way societies deal with deep disagreement? Lessons from Belgium and beyond.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LECTURES & WORKSHOPS -->
  <section class="section section--alt" id="lectures">
    <div class="container">
      <div class="split split--even">
        <div>
          <p class="eyebrow">Public engagement</p>
          <h2>Lectures &amp; workshops</h2>
          <p class="prose">I speak for a wide range of audiences: trade unions, local governments, civil society organisations, schools, media professionals, corporate teams, and the general public. Every talk is tailored to the audience and grounded in the latest political science research.</p>
        </div>
        <figure class="figure">
          <img src="/images/public-speaking.jpg" alt="Kamil Bernaerts giving a public lecture" />
          <figcaption>&copy; Greetje Van Buggenhout</figcaption>
        </figure>
      </div>

      <div class="grid-2" style="margin-top: 2rem;">
        <div class="card">
          <h3>Formats</h3>
          <p>Keynote lecture (45–60 min)<br>Interactive workshop (half day)<br>Panel discussion or debate<br>Q&amp;A session following a lecture<br>School guest lecture (adapted for secondary education)<br>Custom format on request</p>
        </div>
        <div class="card">
          <h3>Selected appearances</h3>
          <p>
            <a href="https://www.vub.be/nl/nieuws/vub-pact-school-tour-caroline-pauwels-atheneum-polarisatie" target="_blank" rel="noopener">VUB PACT School Tour ↗</a> (Caroline Pauwels Academy of Critical Thinking)<br>
            <a href="https://checkfirst.network/event/lunch-lecture-with-kamil-bernaerts/" target="_blank" rel="noopener">EDMO BELUX Lunch Lecture ↗</a><br>
            <a href="https://puc.kuleuven.be/nl/opleiding/polarisatie-8adjxg90jwgep574/" target="_blank" rel="noopener">KU Leuven Metaforum ↗</a> on polarisation<br>
            Public events via the Hannah Arendt Institute
          </p>
        </div>
      </div>

      <div class="cta-banner" style="margin-top: 2rem;">
        <div>
          <h3>Planning an event?</h3>
          <p>Tell me about your audience and I will propose a fitting format.</p>
        </div>
        <a href="/contact/" class="btn btn--blue">Get in touch →</a>
      </div>
    </div>
  </section>

  <!-- IN THE MEDIA -->
  <section class="section" id="media">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">In the media</p>
        <h2>Press &amp; media coverage</h2>
        <p>My research on institutional design, polarisation, and democracy has been covered in Belgian and international media.</p>
      </div>
      <div class="entry-list">
        <div class="entry">
          <div>
            <h3 class="entry__title">Polarisatie: bedreiging of motor voor democratie? — press release PhD</h3>
            <p class="entry__sub"><a href="https://press.vub.ac.be/polarisatie-bedreiging-of-motor-voor-democratie" target="_blank" rel="noopener">VUB Press ↗</a></p>
          </div>
          <div class="entry__meta"><p>2025</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">"Democracy is never finished" — interview with Kamil Bernaerts &amp; Didier Caluwaerts</h3>
            <p class="entry__sub"><a href="https://www.vub.be/en/news/democracy-is-never-finished" target="_blank" rel="noopener">VUB News ↗</a></p>
          </div>
          <div class="entry__meta"><p>2024</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Onderzoek VUB: Belgische democratie minder gevoelig voor polarisering</h3>
            <p class="entry__sub"><a href="https://www.knack.be/nieuws/belgie/politiek/onderzoek-vub-belgische-democratie-minder-gevoelig-voor-polarisering/" target="_blank" rel="noopener">Knack ↗</a></p>
          </div>
          <div class="entry__meta"><p>2022</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">VUB: Belgische democratie is minder gevoelig aan polarisering</h3>
            <p class="entry__sub"><a href="https://www.hln.be/binnenland/vub-belgische-democratie-is-minder-gevoelig-aan-polarisering~a19058f5/" target="_blank" rel="noopener">Het Laatste Nieuws ↗</a></p>
          </div>
          <div class="entry__meta"><p>2022</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Notre système politique belge divise moins la société en deux</h3>
            <p class="entry__sub"><a href="https://www.rtbf.be/article/notre-systeme-politique-belge-divise-moins-la-societe-en-deux-que-les-democraties-majoritaires-selon-une-these-de-la-vub-11120434" target="_blank" rel="noopener">RTBF ↗</a></p>
          </div>
          <div class="entry__meta"><p>2022</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Onderzoek VUB: Belgische democratie minder gevoelig voor polarisering</h3>
            <p class="entry__sub"><a href="https://www.bruzz.be/samenleving/onderzoek-vub-belgische-democratie-minder-gevoelig-voor-polarisering-2022-12-09" target="_blank" rel="noopener">BRUZZ ↗</a></p>
          </div>
          <div class="entry__meta"><p>2022</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">La démocratie belge moins sensible à la polarisation</h3>
            <p class="entry__sub"><a href="https://www.lalibre.be/belgique/societe/2022/12/09/la-democratie-belge-moins-sensible-a-la-polarisation-MQ7FYPXDKVFLJO7TVFDED2L3QA/" target="_blank" rel="noopener">La Libre Belgique ↗</a></p>
          </div>
          <div class="entry__meta"><p>2022</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Belgium's democracy less prone to polarisation</h3>
            <p class="entry__sub"><a href="https://www.brusselstimes.com/politics/335217/belgiums-democracy-less-prone-to-polarisation" target="_blank" rel="noopener">The Brussels Times ↗</a></p>
          </div>
          <div class="entry__meta"><p>2022</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">La démocratie belge moins sensible à la polarisation</h3>
            <p class="entry__sub"><a href="https://www.rtl.be/info/belgique/politique/la-democratie-belge-moins-sensible-a-la-polarisation-1420273.aspx" target="_blank" rel="noopener">RTL Info ↗</a></p>
          </div>
          <div class="entry__meta"><p>2022</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PUBLIC WRITING -->
  <section class="section section--alt" id="public-writing">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Public writing</p>
        <h2>Essays &amp; public writing</h2>
        <p>Alongside academic publications, I write accessible essays and commentaries on current affairs. These pieces are occasionally republished.</p>
      </div>
      <div class="entry-list">
        <div class="entry">
          <div>
            <h3 class="entry__title"><a href="/writing/vdem-2025-nl/">De autocratiserende tsunami is aan land gekomen in het Westen</a></h3>
            <p class="entry__sub">kamilbernaerts.com · republished by <a href="https://hannah-arendt.institute/nieuws/autocratisering-westen-democratie-wereldwijd-onder-druk/" target="_blank" rel="noopener">Hannah Arendt Instituut ↗</a></p>
          </div>
          <div class="entry__meta"><p>2026</p></div>
        </div>
      </div>
      <a href="/writing/" class="more-link">All writing →</a>
    </div>
  </section>

  <!-- HAI -->
  <section class="section" id="hai">
    <div class="container">
      <div class="split">
        <div class="prose">
          <p class="eyebrow">Hannah Arendt Instituut</p>
          <h2>Senior academic fellow</h2>
          <p>The <a href="https://hannah-arendt.institute/" target="_blank" rel="noopener">Hannah Arendt Institute</a> for diversity, urbanity, and citizenship started as a collaboration between VUB and UAntwerpen, but currently involves all Flemish universities as a bridging organisation between civil society, political practice and academia. It combines scientific knowledge about citizenship, urban life, and diversity with the practices and insights of policymakers, organisations, and citizens.</p>
          <p>As a member of the <a href="https://hannah-arendt.institute/samenwerken/onderzoeker/" target="_blank" rel="noopener">academic team</a>, I help organise academic and public events and bring expertise on democratic resilience to the Institute. As the Institute connects civil society actors, it creates valuable opportunities to present my research to broader audiences. It is also a place where I learn to translate academic work into accessible language, giving research meaning beyond the academy.</p>
        </div>
        <div class="stack">
          <img src="/images/hai-logo.svg" alt="Hannah Arendt Instituut logo" style="height: 64px; width: auto; align-self: flex-start; margin-bottom: 0.5rem;" />
          <LinkCard href="https://hannah-arendt.institute/project/democratie-en-polarisatie/" title="My HAI profile" sub="Democratie en polarisatie" />
          <LinkCard href="mailto:kamil.bernaerts@hannah-arendt.institute" title="Email (HAI)" sub="kamil.bernaerts@hannah-arendt.institute" />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
