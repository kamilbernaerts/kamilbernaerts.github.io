---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import { dissertationAbstract } from '../data/publications.js';
---

<BaseLayout title="PhD" description="Friends or Foes: Does polarisation really undermine democracy?">

  <PageHeader
    eyebrow="PhD research"
    title="Friends or Foes: Does polarisation really undermine democracy?"
    lead="Understanding the two-way relationship between polarisation dynamics and the processes and institutions of democratic contestation."
  />

  <!-- DISSERTATION INFO + BOOK COVER -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <div class="section__head">
            <p class="eyebrow">Dissertation</p>
            <h2>Published as a book by VUBPRESS (2025)</h2>
          </div>
          <div class="grid-3" style="margin-bottom: 2rem;">
            <div class="stat">
              <p class="stat__label">Institutions</p>
              <p class="stat__value">Vrije Universiteit Brussel<br>University of Warwick</p>
            </div>
            <div class="stat">
              <p class="stat__label">Supervisors</p>
              <p class="stat__value">Didier Caluwaerts (VUB)<br>Michael Saward (Warwick)</p>
            </div>
            <div class="stat">
              <p class="stat__label">Funder</p>
              <p class="stat__value">EUTOPIA Co-tutelle PhD Scholarship 2021–2025</p>
            </div>
          </div>
          <div class="stack">
            <LinkCard href="https://plc-journal.eu/article/view/25310" title="Read the published summary" sub="Politics of the Low Countries" />
            <LinkCard href="https://plc-journal.eu/article/view/25455" title="Read the published review" sub="Politics of the Low Countries" />
            <LinkCard href="https://press.vub.ac.be/polarisatie-bedreiging-of-motor-voor-democratie" title="Persbericht (Dutch press release)" sub="VUB Press" />
          </div>
        </div>
        <figure class="figure">
          <img src="/images/Cover.png" alt="PhD dissertation Kamil Bernaerts, cover painting by Hazel Van Hove" style="box-shadow: 0 8px 24px rgba(21, 30, 102, 0.18);" />
          <figcaption>Painting by Hazel Van Hove</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ABSTRACT -->
  <section class="section section--blue-tint">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Abstract</p>
        <h2>What the dissertation shows</h2>
      </div>
      <div class="prose" set:html={dissertationAbstract} />
    </div>
  </section>

  <!-- DEFENCE PHOTO -->
  <section class="section">
    <div class="container">
      <figure class="figure">
        <img src="/images/defense.JPG" alt="PhD defence at Vrije Universiteit Brussel, September 2025" />
        <figcaption>Public defence, September 15, 2025, Vrije Universiteit Brussel.</figcaption>
      </figure>
      <div class="grid-2" style="margin-top: 2rem;">
        <LinkCard href="/research/#publications" title="Articles from the dissertation" sub="All publications, with abstracts" />
        <LinkCard href="/outreach/" title="Invite me to talk about it" sub="Lectures and workshops" />
      </div>
    </div>
  </section>

</BaseLayout>
