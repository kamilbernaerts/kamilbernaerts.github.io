---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import Publication from '../components/Publication.astro';
import { published, workingPapers } from '../data/publications.js';
---

<BaseLayout title="Research" description="My research explores how different forms of polarisation relate to democratic health.">

  <PageHeader
    title="Research"
    lead="My research is driven by a simple, yet challenging question: when does conflict become a threat to democracy?"
  />

  <!-- INTRO + PROFILES -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="prose">
          <h2>Conflict and democracy</h2>
          <p>Our societies are (re)polarising, as the figure below shows, and the most common reaction is to see that as inherently dangerous. My work is built on the conviction that understanding the distinction between the conflict that democracies need and the conflict that destroys them is one of the most urgent tasks for political science today.</p>
          <p>In doing so, I have developed a strong interest in studying different sorts of polarisation, and the broader socio-institutional framework within which it erupts.</p>
        </div>
        <div class="stack">
          <LinkCard href="https://scholar.google.com/citations?user=7Pmo70UAAAAJ&hl=en" title="Google Scholar" sub="Full publication metrics" />
          <LinkCard href="https://researchportal.vub.be/en/persons/kamil-bernaerts" title="VUB Research Portal" sub="Institutional profile" />
          <LinkCard href="https://orcid.org/0000-0002-3380-6639" title="ORCID" sub="0000-0002-3380-6639" />
          <LinkCard href="/phd/" title="PhD research" sub="Dissertation and book" />
        </div>
      </div>

      <figure class="figure figure--chart" style="margin-top: 2.5rem;">
        <img src="/images/polarisation-vdem.png" alt="Figure depicting the global rise of polarisation according to V-Dem data" />
        <figcaption>Global increase in idea-based and identity-based polarisation. Source: V-Dem (2026).</figcaption>
      </figure>
    </div>
  </section>

  <!-- RESEARCH THEMES -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Research themes</h2>
      </div>
      <div class="grid-2">
        <div class="card">
          <h3>Kinds of polarisation and democracy</h3>
          <p>How do different kinds of polarisation relate to democratic behavior?</p>
        </div>
        <div class="card">
          <h3>Institutions and polarisation</h3>
          <p>How do democratic institutions shape polarisation dynamics and their consequences?</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PUBLISHED -->
  <section class="section" id="publications">
    <div class="container">
      <div class="section__head">
        <h2>Published &amp; accepted articles and books</h2>
      </div>
      <div class="entry-list">
        {published.map((pub) => <Publication pub={pub} />)}
      </div>
    </div>
  </section>

  <!-- WORKING PAPERS -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Under review &amp; working papers</h2>
      </div>
      <div class="entry-list">
        {workingPapers.map((pub) => <Publication pub={pub} />)}
      </div>
    </div>
  </section>

  <!-- PHOTO + NEXT STEPS -->
  <section class="section">
    <div class="container">
      <div class="split split--even">
        <figure class="figure">
          <img src="/images/conference.png" alt="Presentation at ECPR General Conference 2022" />
          <figcaption>Presentation at ECPR General Conference 2022.</figcaption>
        </figure>
        <div>
          <h2>Further reading</h2>
          <div class="stack">
            <LinkCard href="/writing/" title="Essays & op-eds" sub="The same research, written for a wide audience" />
            <LinkCard href="/cv/" title="Curriculum vitae" sub="Positions, education and awards" />
            <LinkCard href="/contact/" title="Collaborate" sub="Get in touch about research projects and papers" />
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
