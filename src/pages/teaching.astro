---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkCard from '../components/LinkCard.astro';
---

<BaseLayout title="Teaching" description="My teaching experience in political science, from guest lectures to thesis supervision.">

  <PageHeader
    title="Teaching"
    lead="Teaching the next generation of political scientists is one of the most rewarding parts of my work."
  />

  <!-- AT A GLANCE -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>At a glance</h2>
      </div>
      <div class="grid-3">
        <div class="fact">
          <p class="fact__label">Theses supervised</p>
          <p class="fact__value">17 bachelor theses<br>7 master theses (jury)</p>
        </div>
        <div class="fact">
          <p class="fact__label">Teaching roles</p>
          <p class="fact__value">Guest professor (UHasselt)<br>Workshop supervisor (VUB)<br>Guest lecturer (VUB)</p>
        </div>
        <div class="fact">
          <p class="fact__label">Topics</p>
          <p class="fact__value">Intro to Political Science<br>Polarisation &amp; Democracy<br>Quantitative Methods</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CURRENT + PHOTO -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <div class="section__head">
            <h2>Current teaching</h2>
          </div>
          <div class="entry-list">
            <div class="entry">
              <div>
                <h3 class="entry__title">Introduction to Political Science and Governance</h3>
                <p class="entry__sub">Guest professor (10%) · Universiteit Hasselt · Bachelor's in Social Sciences</p>
              </div>
              <div class="entry__meta"><p>2025–2027</p></div>
            </div>
          </div>
        </div>
        <img src="/images/teaching.jpeg" alt="Lecture at Universiteit Hasselt" class="photo" style="aspect-ratio: 4 / 5;" />
      </div>
    </div>
  </section>

  <!-- PREVIOUS -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>Previous teaching experience</h2>
      </div>
      <div class="entry-list">
        <div class="entry">
          <div>
            <h3 class="entry__title">Bachelor thesis workshop: polarisation and democracy</h3>
            <p class="entry__sub">Supervision of 17 bachelor theses · Bachelor's in Political Science · VUB</p>
          </div>
          <div class="entry__meta"><p>2022–2026</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Guest lecture: polarisation and democracy, a complicated relationship</h3>
            <p class="entry__sub">Course: Democratic Theory and Practice · Bachelor's in Social Sciences · VUB · Prof. Eline Severs</p>
          </div>
          <div class="entry__meta"><p>2025–2026</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Guest lecture: exploring quantitative research methods</h3>
            <p class="entry__sub">Course: Research methodology · Master's in Political Science · VUB · Prof. Vjosa Musliu</p>
          </div>
          <div class="entry__meta"><p>2023–2024</p></div>
        </div>
        <div class="entry">
          <div>
            <h3 class="entry__title">Guest lecture: polarisation and democracy</h3>
            <p class="entry__sub">Course: Challenges to Democracy · Master's in Political Science · VUB · Prof. Didier Caluwaerts</p>
          </div>
          <div class="entry__meta"><p>2022–2023</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- NEXT STEPS -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>For students</h2>
      </div>
      <div class="grid-3">
        <LinkCard href="/research/" title="My research" sub="Background reading for a thesis on polarisation" />
        <LinkCard href="/writing/" title="Essays & op-eds" sub="Short, accessible introductions" />
        <LinkCard href="/contact/" title="Contact me" sub="Questions about a course or thesis" />
      </div>
    </div>
  </section>

</BaseLayout>
