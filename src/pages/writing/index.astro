---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

// ════════════════════════════════════════════════════════════════════════
// HOE VOEG JE EEN NIEUWE POST TOE?
//
// 1. Kopieer één blok { ... } hieronder
// 2. Plak het BOVENAAN de lijst (nieuwste post eerst)
// 3. Vervang de waarden
//
// topics: kies uit de sleutels van `topicLabels` hieronder (of voeg er een
//         toe). Bezoekers kunnen op deze onderwerpen filteren.
// image:  laat weg als er geen afbeelding is.
// ════════════════════════════════════════════════════════════════════════
const topicLabels = {
  democracy: 'Democracy',
  polarisation: 'Polarisation',
  autocratisation: 'Autocratisation',
  institutions: 'Institutions',
  youth: 'Youth',
};

const posts = [
  {
    href: '/writing/vdem-2025-nl/',
    title: 'De derde golf van autocratisering: een ongeziene tsunami?',
    date: '26 maart 2026',
    lang: 'NL',
    source: 'Gebaseerd op het V-Dem-rapport 2026',
    excerpt: 'Nu volgens het laatste V-Dem rapport de democratie wereldwijd onder ongekende druk staat, bespreekt dit artikel de mondiale staat van de democratie in 2025. De democratie is teruggevallen naar het niveau van 1978, en de golf van autocratisering heeft nu elke regio van de wereld bereikt.',
    image: '/images/vdem-1.png',
    imageAlt: 'Kaart van regimetypes ter wereld',
    topics: ['democracy', 'autocratisation'],
    cta: 'Lees het artikel',
  },
  {
    href: '/writing/vdem-2025/',
    title: 'The third wave of autocratization: an unprecedented tsunami?',
    date: '26 March 2026',
    lang: 'EN',
    source: 'Based on the 2026 V-Dem report',
    excerpt: "As democracy is under unprecedented pressure worldwide, I provide a short overview of the global state of democracy in 2025 based on V-Dem. The report shows democracy has fallen back to 1978 levels, with autocratisation now reaching Western Europe and North America.",
    image: '/images/vdem-1.png',
    imageAlt: 'Map of regimes of the world',
    topics: ['democracy', 'autocratisation'],
    cta: 'Read the article',
  },
  {
    href: '/writing/bataljong-polarisatie/',
    title: 'Wanneer wij niet meer jij en ik zijn, maar zij, die en hij',
    date: '1 september 2024',
    lang: 'NL',
    source: 'Dropzone (Bataljong)',
    excerpt: 'Polarisatie hoeft niet altijd slecht te zijn. Zonder meningsverschillen zou onze maatschappij niet kunnen evolueren. Maar groepsdenken, een vijandsbeeld en sterke negatieve emoties zijn wel degelijk gevaarlijke alarmsignalen.',
    topics: ['polarisation', 'democracy', 'youth'],
    cta: 'Lees het artikel',
  },
  {
    href: '/writing/polarisatie-democratieen/',
    title: 'Waarom kampen sommige democratieën meer met polarisatie dan andere?',
    date: '20 oktober 2022',
    lang: 'NL',
    source: 'Stuk Rood Vlees · met Benjamin Blanckaert & Didier Caluwaerts',
    excerpt: 'Politieke instellingen verklaren waarom consensusdemocratieën minder polarisatie vertonen dan meerderheidsdemocratieën. Dat is goed nieuws voor beleidsmakers: onder de juiste institutionele voorwaarden kunnen democratieën polarisatie terugdringen.',
    image: '/images/post1-header.jpg',
    imageAlt: 'Polarisatie en democratie',
    topics: ['polarisation', 'democracy', 'institutions'],
    cta: 'Lees het artikel',
  },
];

const usedTopics = Object.keys(topicLabels).filter((t) => posts.some((p) => p.topics.includes(t)));
---

<BaseLayout title="Writing" description="Blog posts and op-eds on democracy, polarisation, and political institutions.">

  <PageHeader
    title="Writing"
    lead="Blog posts and op-eds on democracy, polarisation, and political institutions, in Dutch and English."
  />

  <section class="section">
    <div class="container">

      <div class="filter-bar" role="group" aria-label="Filter by language">
        <span class="filter-bar__label">Language</span>
        <button type="button" class="chip" id="filter-lang-all" data-filter="lang" data-value="all" aria-pressed="true">All</button>
        <button type="button" class="chip" id="filter-lang-nl" data-filter="lang" data-value="NL" aria-pressed="false">Nederlands</button>
        <button type="button" class="chip" id="filter-lang-en" data-filter="lang" data-value="EN" aria-pressed="false">English</button>
      </div>
      <div class="filter-bar" role="group" aria-label="Filter by topic">
        <span class="filter-bar__label">Topic</span>
        <button type="button" class="chip" id="filter-topic-all" data-filter="topic" data-value="all" aria-pressed="true">All</button>
        {usedTopics.map((t) => (
          <button type="button" class="chip" id={`filter-topic-${t}`} data-filter="topic" data-value={t} aria-pressed="false">{topicLabels[t]}</button>
        ))}
      </div>

      <div id="postList" style="margin-top: 1.75rem;">
        {posts.map((post) => (
          <article class="post-card" data-lang={post.lang} data-topics={post.topics.join(' ')}>
            {post.image
              ? <img src={post.image} alt={post.imageAlt} class="post-card__thumb" loading="lazy" />
              : <div class="post-card__thumb post-card__thumb--empty" aria-hidden="true"></div>}
            <div>
              <p class="post-card__meta"><span class="post-card__lang">{post.lang}</span> · {post.date} · {post.source}</p>
              <h2 class="post-card__title"><a href={post.href}>{post.title}</a></h2>
              <p class="post-card__excerpt">{post.excerpt}</p>
              <div class="tag-row">
                {post.topics.map((t) => (
                  <button type="button" class="chip" data-filter="topic" data-value={t} aria-pressed="false" title={`Show all articles on ${topicLabels[t].toLowerCase()}`}>{topicLabels[t]}</button>
                ))}
              </div>
              <a href={post.href} class="more-link">{post.cta} →</a>
            </div>
          </article>
        ))}
        <p id="noPosts" class="muted" hidden>No articles match this combination yet. <button type="button" class="chip" id="filter-reset">Show all articles</button></p>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  const state = { lang: 'all', topic: 'all' };
  const chips = document.querySelectorAll('.chip[data-filter]');
  const posts = document.querySelectorAll('.post-card');
  const empty = document.getElementById('noPosts');

  function apply() {
    let visible = 0;
    posts.forEach((post) => {
      const okLang = state.lang === 'all' || post.dataset.lang === state.lang;
      const okTopic = state.topic === 'all' || post.dataset.topics.split(' ').includes(state.topic);
      post.hidden = !(okLang && okTopic);
      if (!post.hidden) visible++;
    });
    chips.forEach((chip) => {
      chip.setAttribute('aria-pressed', String(state[chip.dataset.filter] === chip.dataset.value));
    });
    if (empty) empty.hidden = visible > 0;
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const { filter, value } = chip.dataset;
      // Clicking the active topic again switches the filter off.
      state[filter] = state[filter] === value && value !== 'all' ? 'all' : value;
      apply();
    });
  });

  document.getElementById('filter-reset')?.addEventListener('click', () => {
    state.lang = 'all';
    state.topic = 'all';
    apply();
  });
</script>
