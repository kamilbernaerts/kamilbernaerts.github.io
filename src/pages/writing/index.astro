---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

// ════════════════════════════════════════════════════════════════════════
// HOE VOEG JE EEN NIEUW ARTIKEL TOE?
//
// Deze pagina vult zichzelf. Maak een nieuw .md-bestand in deze map
// (kopieer een bestaand artikel) en pas bovenaan de gegevens aan:
//
//   title:    de kop
//   date:     de datum zoals ze getoond wordt, bv. "26 March 2026"
//   sortDate: dezelfde datum als "2026-03-26" (bepaalt de volgorde)
//   lang:     "NL" of "EN"
//   topics:   onderwerpen voor de filter, uit de lijst hieronder
//   image:    optioneel, bv. "/images/mijn-foto.jpg"
//
// Het nieuwste artikel komt automatisch bovenaan als hoofdartikel, en de
// eerste zinnen van de tekst worden automatisch als inleiding getoond.
// ════════════════════════════════════════════════════════════════════════
const topicLabels = {
  democracy: 'Democracy',
  polarisation: 'Polarisation',
  autocratisation: 'Autocratisation',
  institutions: 'Institutions',
  youth: 'Youth',
};

// The opening of an article: whole sentences from its first paragraph, up to a word limit.
function opening(raw, maxWords) {
  const paragraph = raw
    .split(/\n\s*\n/)
    .map((block) => block.trim())
    .find((block) => block && !block.startsWith('<') && !block.startsWith('#')) || '';
  const text = paragraph
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_]/g, '')
    .replace(/\s+/g, ' ');
  const sentences = text.split(/(?<=[.!?])\s+/);
  let out = '';
  for (const sentence of sentences) {
    const next = out ? `${out} ${sentence}` : sentence;
    if (out && next.split(' ').length > maxWords) break;
    out = next;
  }
  return out;
}

const posts = Object.values(import.meta.glob('./*.md', { eager: true }))
  .map((post) => ({
    ...post.frontmatter,
    href: post.url.endsWith('/') ? post.url : `${post.url}/`,
    raw: post.rawContent(),
    topics: post.frontmatter.topics || [],
  }))
  .sort((a, b) =>
    (b.sortDate || '').localeCompare(a.sortDate || '') || (a.lang === 'EN' ? -1 : 1) - (b.lang === 'EN' ? -1 : 1));

const [lead, ...rest] = posts;
const more = (post) => (post.lang === 'NL' ? 'Lees verder' : 'Continue reading');
const usedTopics = Object.keys(topicLabels).filter((t) => posts.some((p) => p.topics.includes(t)));
---

<BaseLayout title="Writing" description="Blog posts and op-eds on democracy, polarisation, and political institutions.">

  <PageHeader
    title="Writing"
    lead="Blog posts and op-eds on democracy, polarisation, and political institutions, in Dutch and English."
  />

  <section class="section">
    <div class="container">

      <div class="filter-bar" role="group" aria-label="Filter by language">
        <span class="filter-bar__label">Language</span>
        <button type="button" class="chip" id="filter-lang-all" data-filter="lang" data-value="all" aria-pressed="true">All</button>
        <button type="button" class="chip" id="filter-lang-nl" data-filter="lang" data-value="NL" aria-pressed="false">Nederlands</button>
        <button type="button" class="chip" id="filter-lang-en" data-filter="lang" data-value="EN" aria-pressed="false">English</button>
      </div>
      <div class="filter-bar" role="group" aria-label="Filter by topic">
        <span class="filter-bar__label">Topic</span>
        <button type="button" class="chip" id="filter-topic-all" data-filter="topic" data-value="all" aria-pressed="true">All</button>
        {usedTopics.map((t) => (
          <button type="button" class="chip" id={`filter-topic-${t}`} data-filter="topic" data-value={t} aria-pressed="false">{topicLabels[t]}</button>
        ))}
      </div>

      <div style="margin-top: 1.75rem;">
        <!-- Lead story: the most recent article -->
        <article class="story paper-lead" data-lang={lead.lang} data-topics={lead.topics.join(' ')} lang={lead.lang.toLowerCase()}>
          <div>
            <p class="story__meta"><span class="story__lang">{lead.lang}</span> · {lead.date}{lead.venue && ` · ${lead.venue}`}</p>
            <h2><a href={lead.href}>{lead.title}</a></h2>
            <p class="story__text">{opening(lead.raw, 110)}</p>
            <a href={lead.href} class="more-link">{more(lead)} →</a>
          </div>
          {lead.image && <img src={lead.image} alt="" class="story__img" />}
        </article>

        <!-- The other articles, in columns -->
        <div class="paper-grid">
          {rest.map((post) => (
            <article class="story" data-lang={post.lang} data-topics={post.topics.join(' ')} lang={post.lang.toLowerCase()}>
              {post.image && <img src={post.image} alt="" class="story__img" loading="lazy" />}
              <p class="story__meta"><span class="story__lang">{post.lang}</span> · {post.date}{post.venue && ` · ${post.venue}`}</p>
              <h2><a href={post.href}>{post.title}</a></h2>
              <p class="story__text">{opening(post.raw, 60)}</p>
              <a href={post.href} class="more-link">{more(post)} →</a>
            </article>
          ))}
        </div>

        <p id="noPosts" class="muted" hidden>No articles match this combination yet. <button type="button" class="chip" id="filter-reset">Show all articles</button></p>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  const state = { lang: 'all', topic: 'all' };
  const chips = document.querySelectorAll('.chip[data-filter]');
  const stories = document.querySelectorAll('.story[data-lang]');
  const empty = document.getElementById('noPosts');

  function apply() {
    let visible = 0;
    stories.forEach((story) => {
      const okLang = state.lang === 'all' || story.dataset.lang === state.lang;
      const okTopic = state.topic === 'all' || story.dataset.topics.split(' ').includes(state.topic);
      story.hidden = !(okLang && okTopic);
      if (!story.hidden) visible++;
    });
    chips.forEach((chip) => {
      chip.setAttribute('aria-pressed', String(state[chip.dataset.filter] === chip.dataset.value));
    });
    if (empty) empty.hidden = visible > 0;
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      state[chip.dataset.filter] = chip.dataset.value;
      apply();
    });
  });

  document.getElementById('filter-reset')?.addEventListener('click', () => {
    state.lang = 'all';
    state.topic = 'all';
    apply();
  });
</script>
